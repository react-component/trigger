{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "node",
    "baseUrl": "./",
    "jsx": "react",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "@testing-library/jest-dom",
      "node"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@@/*": [
        ".dumi/tmp/*"
      ],
      "@rc-component/trigger": [
        "src/index.tsx"
      ],
      "@rc-component/trigger/es": [
        "src"
      ],
      "@rc-component/trigger/es/*": [
        "src/*"
      ],
      "@rc-component/trigger/assets/*": [
        "assets/*"
      ]
    },
    "ignoreDeprecations": "5.0"
  },
  "include": [
    ".dumirc.ts",
    ".fatherrc.ts",
    "src",
    "tests",
    "docs/examples"
  ],
  "exclude": [
    "docs-dist",
    "lib",
    "es"
  ]
}
